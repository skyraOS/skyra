#!/bin/bash
# skyra: one command for the whole project. Installed onto PATH by ./install.sh.
set -euo pipefail

# Resolve the repo root through the symlink install.sh puts on PATH.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
ROOT=$(cd "$(dirname "$self")" && pwd)
BUILD=$ROOT/build
# The workspace the read tool is granted: where skyra was started, unless set.
# Captured before anything below changes directory.
WORKSPACE=${SKYRA_WORKSPACE:-$PWD}
WS_PORT=${SKYRA_WS_PORT:-8080}
UI_PORT=${SKYRA_UI_PORT:-3000}

say() { printf '\033[1mskyra:\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mskyra:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
usage: skyra [command]

  (none)        chat with Codex in the browser, through the stateless controller:
                every conversation is a lineage, saved and listed with its history
  chat --fake   the same, against a deterministic fake Codex (no model, no login)
  tui           chat with Codex in the terminal, using the same conversations
  tui --fake    the terminal UI against the deterministic fake Codex
  app           build and open Skyra.app, the desktop client (next/23)
  serve [--fake]  the backend alone, as the desktop app starts it: the webhost,
                its log on stdout, SKYRA_WS_TOKEN generated unless supplied
  ask "TEXT"    one question to real Codex through the controller; prints the lineage,
                the replay check and the answer
  desktop       choose a window, then chat with read-only vision (macOS)
  desktop --list  list windows for scripted selection
  desktop --app ID --pid PID --window-id ID chat
                chat with read-only vision of that selected window
  replay DIR    re-derive a finished conversation or run from its records
  stop          stop any actor hosts left by an older Skyra version
  demo          the stateless controller: every scenario, each ending in a replay check
  test          controller, interpreter, browser, desktop, website and demos
  doctor        check prerequisites
  build         build every binary into build/

Ports: SKYRA_WS_PORT (default 8080), SKYRA_UI_PORT (default 3000).
Setup and troubleshooting: $ROOT/docs/startup-doc.md
EOF
}

port_free() { ! lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

kill_tree() {
  local child
  for child in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$child"; done
  kill "$1" 2>/dev/null || true
}

# Each conversation's Codex app-server lives behind its edge's holder
# (proposal 38), which reclaims it after about half an hour idle.
STATE=${SKYRA_STATE:-$HOME/.skyra}
# All launch modes authenticate ingress. Credentials travel in the environment.
export SKYRA_WS_TOKEN=${SKYRA_WS_TOKEN:-$(python3 -c 'import secrets; print(secrets.token_hex(32))')}
umask 077

controller_build() {
  mkdir -p "$BUILD/controller"
  cd "$ROOT"
  local t
  local builds="skyra:skyra echo:targets/echo read:targets/read find:targets/find write:targets/write roots:targets/roots agent:targets/agent user:targets/user
    codexresident:codex/resident codexio:codex/io webhost:hosts/web fake-codex:codex/fake
    clauderesident:claude/resident claude-start:claude/start
    desktop-observe:cua/adapter cua-bridge:cua/bridge ideas-host:hosts/ideas design-tools:design repo-host:hosts/repo blender-tools:blender"
  for t in $builds; do go build -o "$BUILD/controller/${t%%:*}" "./controller/${t#*:}"; done
  # Operator discovery runs outside model authority.
  if [ "$(uname -s)" = Darwin ]; then
    clang -fobjc-arc -framework AppKit -framework CoreGraphics "$ROOT/controller/cua/windows.m" -o "$BUILD/controller/cua-windows"
  fi
  # The interpreter is its own module (next/32).
  (cd "$ROOT/controller/interp" && go build -o "$BUILD/controller/interp" .)
  go build -o "$BUILD/tui" ./tui
}

# registry MODE PARK_SOCK OWNER_DEPTH [TAG]: the operator's registry. The
# resource owner is the operator for ask, and the user frame for chat/tui. TAG
# keeps a client's registry apart from another's that parks on another socket.
registry() {
  # A launch owns its registry and response socket. Another workspace or
  # smoke-test backend must never replace the live app's grants or inbox.
  local mode=$1 park=$2 depth=$3 file="$BUILD/controller/registry-$1-$3${4:+-$4}-$$.json"
  SKYRA_REGISTRY_ROOT="$ROOT" SKYRA_REGISTRY_BUILD="$BUILD/controller" \
    SKYRA_REGISTRY_MODE="$mode" SKYRA_REGISTRY_PARK="$park" \
    SKYRA_IDEAS_SOCKET="${IDEAS_SOCKET:-}" \
    SKYRA_REPO_SOCKET="${REPO_SOCKET:-}" \
    SKYRA_REGISTRY_DEPTH="$depth" SKYRA_REGISTRY_FILE="$file" \
    SKYRA_REGISTRY_WORKSPACE="$WORKSPACE" SKYRA_REGISTRY_STATE="$STATE" python3 - <<'PY' || return 1
import json, os, sys
from pathlib import Path
root=Path(os.environ['SKYRA_REGISTRY_ROOT'])
build=Path(os.environ['SKYRA_REGISTRY_BUILD'])
launch=Path(os.environ['SKYRA_REGISTRY_FILE']).stem
# The read grant. The sandbox denies only this run's .skyra, so the workspace
# must not contain Skyra's state (other conversations, provider logins) or
# Codex's login, and must not be the home directory or the filesystem root.
workspace=Path(os.environ['SKYRA_REGISTRY_WORKSPACE']).resolve(strict=True)
home=Path.home().resolve()
for private in [Path(os.environ['SKYRA_REGISTRY_STATE']), home/'.codex']:
    private=private.resolve()
    if workspace==private or workspace in private.parents or private in workspace.parents:
        sys.exit(f'skyra: the workspace {workspace} overlaps {private}; start skyra in a project directory or set SKYRA_WORKSPACE')
if workspace in (home, Path('/')) or not workspace.is_dir():
    sys.exit(f'skyra: {workspace} cannot be the workspace; start skyra in a project directory or set SKYRA_WORKSPACE')
sys.path.insert(0,str(root/'controller/codex/provider'))
from launch import FEATURES, verified_version
from sandbox import native_binary
mode=os.environ['SKYRA_REGISTRY_MODE']
if mode=='real':
    binary=native_binary().resolve(strict=True)
    verified_version(binary)
    args=[]
    for feature in FEATURES: args.extend(['--disable',feature])
    args.extend(['--enable','skip_host_skill_discovery','--enable','view_image','app-server','--listen','stdio://'])
    start={'path':str(binary),'resident_profile':'darwin-appserver-v1',
           'proxy_hosts':['chatgpt.com','api.openai.com','auth.openai.com'],
           'proxy_path':str(root/'controller/codex/provider/proxy.py'),'args':args}
else:
    start={'path':str(build/'fake-codex')}
start.update({'contract':str(root/'controller/codex/io/start-contract.json'),'resident':True})
registry={
 'echo':{'path':str(build/'echo'),'contract':str(root/'controller/targets/echo/contract.json')},
 'read':{'path':str(build/'read'),'contract':str(root/'controller/targets/read/contract.json'),
         'authority':{'read':[{'path':str(workspace),'scope':'subpath'}]}},
 'find':{'path':str(build/'find'),'contract':str(root/'controller/targets/find/contract.json'),
         'authority':{'read':[{'path':str(workspace),'scope':'subpath'}]}},
 'roots':{'path':str(build/'roots'),'contract':str(root/'controller/targets/roots/contract.json')},
 'write':{'path':str(build/'write'),'contract':str(root/'controller/targets/write/contract.json')},
 'codex':{'path':str(build/'codexresident'),'contract':str(root/'controller/codex/resident/contract.json')},
 'codex.start':start,
 # Codex's operations reach its app-server through their edge's holder
 # (proposal 38): each is granted exactly that socket, nothing else.
 'codex.exchange':{'path':str(build/'codexio'),'contract':str(root/'controller/codex/io/contract.json'),'connection':True},
 'codex.inspect':{'path':str(build/'codexio'),'contract':str(root/'controller/codex/io/contract.json'),'connection':True},
 'codex.stop':{'path':str(build/'codexio'),'contract':str(root/'controller/codex/io/contract.json'),'connection':True},
 'claude':{'path':str(build/'clauderesident'),'contract':str(root/'controller/claude/resident/contract.json')},
 'claude.start':{'path':str(build/'claude-start'),'contract':str(root/'controller/codex/io/start-contract.json'),'resident':True,'resident_profile':'darwin-claude-v1'},
 'claude.exchange':{'path':str(build/'codexio'),'contract':str(root/'controller/codex/io/contract.json'),'connection':True},
 'claude.inspect':{'path':str(build/'codexio'),'contract':str(root/'controller/codex/io/contract.json'),'connection':True},
 'claude.stop':{'path':str(build/'codexio'),'contract':str(root/'controller/codex/io/contract.json'),'connection':True},
 'user':{'path':str(build/'user'),'contract':str(root/'controller/targets/user/contract.json')},
 # The interpreter (next/32): remember, the procedures it builds, in its own state,
 # and the authored procedures a conversation runs (think, proposal 38).
 'interpreter':{'path':str(build/'interp'),'contract':str(root/'controller/interp/contract.json'),'state':True,
                'bundle':str(root/'controller/interp/workflows/think/bundle.json')},
 'browser':{'host':os.environ['SKYRA_REGISTRY_PARK'],'contract':str(root/'controller/targets/browser/contract.json')}
}
desktop_config=os.environ.get('SKYRA_DESKTOP_CONFIG')
if desktop_config:
    config=json.loads(Path(desktop_config).read_text())
    socket=Path(config['socket'])
    import stat
    if not socket.is_absolute() or not stat.S_ISSOCK(socket.stat().st_mode) or socket.parent.stat().st_mode & 0o077:
        sys.exit('skyra: desktop bridge must be a socket in a private directory')
    contract=json.loads((root/'controller/cua/adapter/contract.json').read_text())
    evidence={k:config[k] for k in ('bundle_id','pid','window_id','driver_version','driver_binary_sha256','manifest_sha256')}
    contract['input']['title']='Desktop scope: '+json.dumps(evidence,sort_keys=True)
    contract_path=build/'desktop-contract.json'
    contract_path.write_text(json.dumps(contract,sort_keys=True))
    registry['desktop_observe']={'path':str(build/'desktop-observe'),'contract':str(contract_path),
        'authority':{'connect':[str(socket)]}}
    bundle=json.loads((root/'controller/interp/workflows/think/bundle.json').read_text())
    bundle['procedures'][0]['nodes']['scope']['in']['narrow']['reach'].append('desktop_observe')
    bundle_path=build/'desktop-think.json'
    bundle_path.write_text(json.dumps(bundle,sort_keys=True))
    registry['interpreter']['bundle']=str(bundle_path)
# In this workspace, write is an authored procedure: raw write, then commit.
# The Git host receives only an observation; no actor gains Git authority.
ideas_socket=os.environ.get('SKYRA_IDEAS_SOCKET','')
if workspace==root.resolve(strict=True):
    if not ideas_socket: sys.exit('skyra: ideas commit host is not running')
    registry['write.file']=registry['write']
    registry['write']={'path':str(build/'interp'),'contract':str(root/'controller/interp/workflows/write/contract.json'),
                       'state':True,'bundle':str(root/'controller/interp/workflows/write/bundle.json')}
    registry['ideas.commit']={'host':ideas_socket,'contract':str(root/'controller/hosts/ideas/contract.json')}
    think=json.loads(Path(registry['interpreter']['bundle']).read_text())
    think['procedures'][0]['nodes']['scope']['in']['narrow']['reach'].extend(['write.file','ideas.commit'])
    think_file=build/(launch+'-think-ideas-bundle.json')
    think_file.write_text(json.dumps(think,sort_keys=True))
    registry['interpreter']['bundle']=str(think_file)
# Repository edits and Git run through recorded host actors. The execve
# contract is just target + argv; its host binds git to this repository.
if workspace==root.resolve(strict=True):
    repo_socket=os.environ.get('SKYRA_REPO_SOCKET','')
    if not repo_socket: sys.exit('skyra: repository host is not running')
    registry['repo.write']={'host':repo_socket,'contract':str(root/'controller/hosts/repo/write-contract.json')}
    registry['execve']={'host':repo_socket,'contract':str(root/'controller/hosts/repo/contract.json')}
    registry['repo.check']={'host':repo_socket,'contract':str(root/'controller/hosts/repo/check-contract.json')}
    think=json.loads(Path(registry['interpreter']['bundle']).read_text())
    think['procedures'][0]['nodes']['scope']['in']['narrow']['reach'].extend(['repo.write','execve','repo.check'])
    think_file=build/(launch+'-think-repo-bundle.json')
    think_file.write_text(json.dumps(think,sort_keys=True))
    registry['interpreter']['bundle']=str(think_file)
# Design is callable from think and has its own root. Dependencies remain in
# reach for nested invocation; only the design worker is offered design.tools.
registry['design']={'path':str(build/'interp'),'contract':str(root/'controller/interp/workflows/design/contract.json'),
 'state':True,'bundle':str(root/'controller/interp/workflows/design/bundle.json')}
registry['design.tools']={'path':str(build/'design-tools'),'contract':str(root/'controller/design/contract.json')}
penpot_socket=os.environ.get('SKYRA_PENPOT_SOCKET')
if penpot_socket:
    import stat
    socket=Path(penpot_socket)
    if not socket.is_absolute() or not stat.S_ISSOCK(socket.stat().st_mode) or socket.parent.stat().st_mode & 0o077:
        sys.exit('skyra: Penpot bridge must be private')
    registry['design.tools']['authority']={'connect':[str(socket)]}
think=json.loads(Path(registry['interpreter']['bundle']).read_text())
think['procedures'][0]['nodes']['scope']['in']['narrow']['reach'].extend(['codex','design','design.tools'])
think_file=build/(launch+'-think-design-bundle.json')
think_file.write_text(json.dumps(think,sort_keys=True))
registry['interpreter']['bundle']=str(think_file)
# Bounded offline Blender authoring is a recorded procedure, not global MCP.
registry['blender']={'path':str(build/'interp'),'contract':str(root/'controller/interp/workflows/blender/contract.json'),
 'state':True,'bundle':str(root/'controller/interp/workflows/blender/bundle.json')}
registry['blender.tools']={'path':str(build/'blender-tools'),'contract':str(root/'controller/blender/contract.json')}
blender_socket=os.environ.get('SKYRA_BLENDER_SOCKET')
if blender_socket:
    import stat
    socket=Path(blender_socket)
    if not socket.is_absolute() or not stat.S_ISSOCK(socket.stat().st_mode) or socket.parent.stat().st_mode & 0o077:
        sys.exit('skyra: Blender bridge must be private')
    registry['blender.tools']['authority']={'connect':[str(socket)]}
think=json.loads(Path(registry['interpreter']['bundle']).read_text())
think['procedures'][0]['nodes']['scope']['in']['narrow']['reach'].extend(['blender','blender.tools'])
think_file=build/(launch+'-think-blender-bundle.json')
think_file.write_text(json.dumps(think,sort_keys=True))
registry['interpreter']['bundle']=str(think_file)
# think-claude mirrors think but narrows to the claude adapter. The same
# reach, with codex operations replaced by their claude counterparts.
import copy
think=json.loads(Path(registry['interpreter']['bundle']).read_text())
claude_proc=copy.deepcopy(think['procedures'][0])
claude_proc['contract']['title']='think-claude'
claude_proc['contract']['required']=['think-claude']
claude_proc['contract']['fields']={'think-claude':claude_proc['contract']['fields']['think']}
claude_proc['nodes']['scope']['in']['narrow']['actor']='claude'
claude_proc['nodes']['scope']['in']['narrow']['reach']=[
    'claude.start' if r=='codex.start' else
    'claude.exchange' if r=='codex.exchange' else
    'claude.inspect' if r=='codex.inspect' else
    'claude.stop' if r=='codex.stop' else
    'claude' if r=='codex' else r
    for r in claude_proc['nodes']['scope']['in']['narrow']['reach']]
claude_proc['nodes']['run']['in']['text']={'$':['input','think-claude','text']}
claude_proc['nodes']['run']['in']['context']={'$':['input','think-claude','context']}
claude_proc['nodes']['run']['in']['images']={'$':['input','think-claude','images']}
think['procedures'].append(claude_proc)
think_file=build/(launch+'-think-claude-bundle.json')
think_file.write_text(json.dumps(think,sort_keys=True))
registry['interpreter']['bundle']=str(think_file)
# Each built binary is registered by a copy stored under its own hash. A
# conversation pins its binaries' hashes at genesis, so a rebuild must never
# change a file one points at: it adds new copies and leaves the old ones.
import hashlib, shutil, tempfile
def pinned(path):
    p=Path(path)
    digest=hashlib.sha256(p.read_bytes()).hexdigest()
    dest=build/'pinned'/digest/p.name
    if not dest.exists():
        dest.parent.mkdir(parents=True,exist_ok=True)
        fd,tmp=tempfile.mkstemp(dir=dest.parent); os.close(fd)
        shutil.copy2(p,tmp); os.replace(tmp,dest)
    return str(dest)
for entry in registry.values():
    if 'path' in entry and Path(entry['path']).parent==build:
        entry['path']=pinned(entry['path'])
    for key in ('contract','bundle'):
        if key in entry and Path(entry[key]).parent==build:
            entry[key]=pinned(entry[key])
Path(os.environ['SKYRA_REGISTRY_FILE']).write_text(json.dumps(registry,sort_keys=True))
PY
  echo "$file"
}

# This project's ideas directory is its persistent, bounded write space.
# Other selected workspaces retain their conversation-local scratch directory.
write_space() {
  SKYRA_IDEAS_ROOT="$ROOT" SKYRA_IDEAS_WORKSPACE="$WORKSPACE" python3 - <<'PY'
import os
from pathlib import Path
root = Path(os.environ['SKYRA_IDEAS_ROOT']).resolve(strict=True)
workspace = Path(os.environ['SKYRA_IDEAS_WORKSPACE']).resolve(strict=True)
if workspace == root:
    ideas = root / 'ideas'
    if ideas.is_symlink():
        raise SystemExit('skyra: ideas must be a real directory, not a symlink')
    ideas.mkdir(mode=0o700, exist_ok=True)
    print(ideas.resolve(strict=True))
PY
}

# Git stays in an operator-side host, reached through the park protocol.
start_ideas_host() {
  IDEAS_SOCKET= IDEAS_HOST_PID=
  REPO_SOCKET= REPO_HOST_PID=
  [ -n "$(write_space)" ] || return 0
  mkdir -p "$STATE"
  IDEAS_SOCKET="$STATE/ideas-$$.sock"
  "$BUILD/controller/ideas-host" -repo "$ROOT" -sock "$IDEAS_SOCKET" -skyra "$BUILD/controller/skyra" >"$STATE/ideas-$$.log" 2>&1 &
  IDEAS_HOST_PID=$!
  REPO_SOCKET="$STATE/repo-$$.sock"
  "$BUILD/controller/repo-host" -repo "$ROOT" -sock "$REPO_SOCKET" -skyra "$BUILD/controller/skyra" \
    -go-root "$(go env GOROOT)" -module-cache "$(go env GOMODCACHE)" -python "$(command -v python3)" >"$STATE/repo-$$.log" 2>&1 &
  REPO_HOST_PID=$!
  local i
  for i in $(seq 1 100); do
    kill -0 "$IDEAS_HOST_PID" 2>/dev/null || die "ideas host exited (see $STATE/ideas-$$.log)"
    kill -0 "$REPO_HOST_PID" 2>/dev/null || die "repository host exited (see $STATE/repo-$$.log)"
    [ -S "$IDEAS_SOCKET" ] && [ -S "$REPO_SOCKET" ] && return 0
    sleep 0.1
  done
  die 'ideas commit host did not start'
}

stop_ideas_host() {
  [ -z "${IDEAS_HOST_PID:-}" ] || kill_tree "$IDEAS_HOST_PID"
  [ -z "${REPO_HOST_PID:-}" ] || kill_tree "$REPO_HOST_PID"
}

ask() {
  [ $# -gt 0 ] || die 'usage: skyra ask "TEXT"'
  say "building"
  controller_build
  local reg run scratch
  scratch=$(write_space)
  trap stop_ideas_host INT TERM EXIT
  start_ideas_host
  reg=$(registry real "$STATE/park.sock" 1)
  mkdir -p "$STATE/runs"
  run=$STATE/runs/$(date +%Y%m%d-%H%M%S)-$$/.skyra
  mkdir -p "$run"
  "$BUILD/controller/skyra" boot -root "$run" -registry "$reg" -scratch "$scratch" -to codex -text "$*"
  say "state: $run"
}

# chat [--fake]: the browser UI on the stateless controller. The webhost holds
# every conversation waiting on you; each conversation is saved as its lineage
# under ~/.skyra/conversations (or conversations-fake).
chat() {
  local mode=real
  case ${1:-} in
    ""|--codex) ;;
    --fake) mode=fake ;;
    *) die "unknown chat mode '$1' (use --fake)" ;;
  esac
  [ -d "$ROOT/frontend/node_modules" ] || die "frontend dependencies missing. Run ./install.sh"
  port_free "$WS_PORT" || die "port $WS_PORT is in use (set SKYRA_WS_PORT, or stop the other process)"
  port_free "$UI_PORT" || die "port $UI_PORT is in use (set SKYRA_UI_PORT, or stop the other process)"
  say "building"
  controller_build

  local reg scratch park=$STATE/park-$mode-$$.sock convs=$STATE/conversations
  scratch=$(write_space)
  local addr=127.0.0.1:$WS_PORT web_pid ui_pid
  export SKYRA_WS_ORIGIN=http://localhost:$UI_PORT
  cleanup() {
    trap - INT TERM EXIT
    stop_ideas_host
    say "stopping"
    [ -n "${ui_pid:-}" ] && kill_tree "$ui_pid"
    [ -n "${web_pid:-}" ] && kill_tree "$web_pid"
    wait 2>/dev/null || true
  }
  trap cleanup INT TERM EXIT
  start_ideas_host
  [ "$mode" = fake ] && convs=$STATE/conversations-fake
  reg=$(registry "$mode" "$park" 2)
  "$BUILD/controller/webhost" -ws "$addr" -park "$park" -skyra "$BUILD/controller/skyra" \
    -registry "$reg" -conversations "$convs" -scratch "$scratch" &
  web_pid=$!
  (cd "$ROOT/frontend" && NEXT_PUBLIC_WS_URL="ws://$addr/ws" exec npm run dev -- -H localhost -p "$UI_PORT") &
  ui_pid=$!

  local url=http://localhost:$UI_PORT i
  for i in $(seq 1 60); do
    kill -0 "$web_pid" 2>/dev/null || die "the webhost exited during startup (see the output above)"
    kill -0 "$ui_pid" 2>/dev/null || die "the UI exited during startup (see the output above)"
    curl -s -o /dev/null "$url" && break
    sleep 1
  done
  say "codex: $mode   UI: $url/#skyra-token=$SKYRA_WS_TOKEN   conversations: $convs   runtime trace below   Ctrl-C to stop"
  [ -n "${SKYRA_NO_OPEN:-}" ] || open "$url/#skyra-token=$SKYRA_WS_TOKEN" 2>/dev/null || true
  while kill -0 "$web_pid" 2>/dev/null && kill -0 "$ui_pid" 2>/dev/null; do sleep 1; done
}

# tui [--fake]: the same backend and conversation directory as chat, with a
# terminal client instead of Next.js. Backend logs stay out of the terminal UI.
tui_chat() {
  local mode=real
  case ${1:-} in
    ""|--codex) ;;
    --fake) mode=fake ;;
    *) die "unknown tui mode '$1' (use --fake)" ;;
  esac
  [ -t 0 ] && [ -t 1 ] || die "skyra tui needs an interactive terminal"
  port_free "$WS_PORT" || die "port $WS_PORT is in use (set SKYRA_WS_PORT, or stop the other process)"
  say "building"
  controller_build

  local reg scratch park=$STATE/park-$mode-$$.sock convs=$STATE/conversations
  scratch=$(write_space)
  local addr=127.0.0.1:$WS_PORT web_pid i
  cleanup() {
    trap - INT TERM EXIT
    stop_ideas_host
    [ -n "${web_pid:-}" ] && kill_tree "$web_pid"
  }
  trap cleanup INT TERM EXIT
  start_ideas_host
  [ "$mode" = fake ] && convs=$STATE/conversations-fake
  reg=$(registry "$mode" "$park" 2)
  mkdir -p "$STATE"
  "$BUILD/controller/webhost" -ws "$addr" -park "$park" -skyra "$BUILD/controller/skyra" \
    -registry "$reg" -conversations "$convs" -scratch "$scratch" >"$STATE/tui-webhost.log" 2>&1 &
  web_pid=$!
  for i in $(seq 1 100); do
    kill -0 "$web_pid" 2>/dev/null || die "the webhost exited (see $STATE/tui-webhost.log)"
    [ -S "$park" ] && break
    sleep 0.1
  done
  [ -S "$park" ] || die "the webhost did not start (see $STATE/tui-webhost.log)"
  "$BUILD/tui" -addr "$addr"
  cleanup
}

# serve [--fake]: what the desktop app runs. The same backend and conversations
# as chat and tui, without a client; the app is the client. The launcher's
# workspace checks still decide, and their refusal is this command's output.
serve() {
  local mode=real
  case ${1:-} in
    ""|--codex) ;;
    --fake) mode=fake ;;
    *) die "unknown serve mode '$1' (use --fake)" ;;
  esac
  port_free "$WS_PORT" || die "port $WS_PORT is in use"
  if [ -z "${SKYRA_BLENDER_STARTED:-}" ]; then
    exec python3 "$ROOT/controller/blender/session.py" serve ${1:+"$1"}
  fi
  if [ -z "${SKYRA_PENPOT_STARTED:-}" ]; then
    exec python3 "$ROOT/controller/design/session.py" serve ${1:+"$1"}
  fi

  local stamp="$BUILD/.source-stamp"
  local fingerprint
  fingerprint=$(cd "$ROOT" && { cat go.mod go.sum controller/interp/go.mod controller/interp/go.sum 2>/dev/null; find controller tui -name '*.go' -o -name '*.m' | sort | xargs cat; } | shasum -a 256 | cut -d' ' -f1)
  if [ ! -f "$stamp" ] || [ "$(cat "$stamp" 2>/dev/null)" != "$fingerprint" ]; then
    say "building (source changed)"
    controller_build
    printf '%s' "$fingerprint" > "$stamp"
  fi

  # The normal app backend owns read-only vision automatically. The inner
  # launch has a fixed desktop config and must not start another service.
  if [ "$mode" = real ] && [ -z "${SKYRA_DESKTOP_CONFIG:-}" ]; then
    exec python3 "$ROOT/controller/cua/session.py" --all-windows serve
  fi

  local reg scratch park=$STATE/park-app-$mode-$$.sock convs=$STATE/conversations
  scratch=$(write_space)
  local addr=127.0.0.1:$WS_PORT web_pid i
  cleanup() {
    trap - INT TERM EXIT
    stop_ideas_host
    [ -n "${web_pid:-}" ] && kill_tree "$web_pid"
  }
  trap cleanup INT TERM EXIT
  start_ideas_host
  [ "$mode" = fake ] && convs=$STATE/conversations-fake
  mkdir -p "$STATE"
  reg=$(registry "$mode" "$park" 2 app)
  "$BUILD/controller/webhost" -ws "$addr" -park "$park" -skyra "$BUILD/controller/skyra" \
    -registry "$reg" -conversations "$convs" -scratch "$scratch" &
  web_pid=$!
  # A prior host's parking socket can remain while history loads. Wait for
  # this launch's TCP listener too, before telling the desktop it is ready.
  python3 - "$WS_PORT" "$web_pid" "$park" <<'PY' || die "the webhost did not become ready"
import os, socket, stat, sys, time
port, pid, park = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
deadline = time.monotonic() + 120
while time.monotonic() < deadline:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        sys.exit('skyra: the webhost exited during startup')
    try:
        if stat.S_ISSOCK(os.stat(park).st_mode):
            with socket.create_connection(('127.0.0.1', port), timeout=0.2):
                sys.exit(0)
    except OSError:
        pass
    time.sleep(0.1)
sys.exit('skyra: timed out waiting for the webhost listener')
PY
  say "ready ws://$addr/ws workspace $WORKSPACE"
  wait "$web_pid"
}

# app: build Skyra.app into build/ and open it. SwiftPM needs a full Xcode
# toolchain; use Xcode's when the selected developer directory has none.
# The PATH is recorded in the bundle, because an app opened from Finder gets
# a bare one and serve needs go, python3 and codex.
app() {
  local dir=$BUILD/Skyra.app bin
  if [ -z "${DEVELOPER_DIR:-}" ] && [ -d /Applications/Xcode.app ] && \
     ! xcode-select -p 2>/dev/null | grep -q '\.app/'; then
    export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
  fi
  say "building the controller"
  controller_build
  say "building Skyra.app"
  (cd "$ROOT/desktop" && swift build -c release) || die "swift build failed (it needs Xcode, not only the Command Line Tools)"
  bin=$(cd "$ROOT/desktop" && swift build -c release --show-bin-path)/Skyra
  rm -rf "$dir" "$BUILD/Skyra.iconset"
  mkdir -p "$dir/Contents/MacOS" "$dir/Contents/Resources"
  cp "$bin" "$dir/Contents/MacOS/Skyra"
  # SwiftPM resources are separate bundles, including the optional graphics pilot.
  for resource_bundle in "${bin%/Skyra}"/*.bundle; do
    [ -d "$resource_bundle" ] || continue
    cp -R "$resource_bundle" "$dir/Contents/Resources/"
  done
  swift "$ROOT/desktop/Icon/make-icon.swift" "$BUILD/Skyra.iconset" &&
    iconutil -c icns "$BUILD/Skyra.iconset" -o "$dir/Contents/Resources/Skyra.icns" ||
    say "the icon did not build; the app will use the default one"
  SKYRA_APP_ROOT="$ROOT" SKYRA_APP_PATH="$PATH" SKYRA_APP_PLIST="$dir/Contents/Info.plist" python3 - <<'PY'
import os, plistlib
plistlib.dump({
  'CFBundleName': 'Skyra', 'CFBundleDisplayName': 'Skyra',
  'CFBundleIdentifier': 'local.skyra.desktop', 'CFBundleExecutable': 'Skyra',
  'CFBundlePackageType': 'APPL', 'CFBundleIconFile': 'Skyra', 'CFBundleShortVersionString': '0.1', 'CFBundleVersion': '1',
  'LSMinimumSystemVersion': '14.0', 'NSHighResolutionCapable': True,
  'SkyraRoot': os.environ['SKYRA_APP_ROOT'], 'SkyraPATH': os.environ['SKYRA_APP_PATH'],
}, open(os.environ['SKYRA_APP_PLIST'], 'wb'))
PY
  touch "$dir"   # Finder and the Dock pick up the new icon
  say "built $dir"
  [ -n "${SKYRA_NO_OPEN:-}" ] || open "$dir"
}

stop_host() {
  local mode stopped=0
  for mode in real real-sandbox-v1 real-direct-v2 fake; do
    if [ -f "$STATE/codex-$mode.pid" ] && kill -0 "$(cat "$STATE/codex-$mode.pid")" 2>/dev/null; then
      kill_tree "$(cat "$STATE/codex-$mode.pid")"
      say "stopped the $mode Codex actor host"
      stopped=1
    fi
    rm -f "$STATE/codex-$mode.pid" "$STATE/codex-$mode.sock"
  done
  [ "$stopped" = 1 ] || say "no actor host running"
}

doctor() {
  local ok=1 v
  check() { if eval "$2" >/dev/null 2>&1; then printf '  ok    %s\n' "$1"; else printf '  FAIL  %s: %s\n' "$1" "$3"; ok=0; fi; }
  warn()  { if eval "$2" >/dev/null 2>&1; then printf '  ok    %s\n' "$1"; else printf '  warn  %s: %s\n' "$1" "$3"; fi; }
  echo "skyra doctor ($ROOT)"
  check "macOS" '[ "$(uname)" = Darwin ]' "the sandbox uses sandbox-exec, which is macOS only"
  check "sandbox-exec" 'command -v sandbox-exec' "missing from this macOS"
  check "python3" 'command -v python3' "required for the provider sandbox launcher"
  v=$(go env GOVERSION 2>/dev/null || true)
  check "Go >= 1.25 (${v:-none})" '[ -n "$v" ] && [ "$(printf "%s\n" go1.25 "$v" | sort -V | head -1)" = go1.25 ]' "install Go 1.25+: brew install go"
  check "node and npm" 'command -v node && command -v npm' "install Node 20+: brew install node"
  check "frontend dependencies" '[ -d "$ROOT/frontend/node_modules" ]' "run ./install.sh"
  check "skyra on PATH" '[ "$(command -v skyra)" ]' "run ./install.sh, then open a new terminal"
  warn "codex installed ($(codex --version 2>/dev/null || echo none))" 'command -v codex' "only 'skyra chat' needs it; install: brew install codex"
  warn "codex logged in" 'codex login status' "run 'codex login' (a ChatGPT login works)"
  warn "direct-tool provider configuration" 'python3 "$ROOT/controller/codex/provider/launch.py" --check' "requires Codex 0.160.0, file login and matching model cache; see docs/startup-doc.md"
  warn "port $WS_PORT free" 'port_free "$WS_PORT"' "set SKYRA_WS_PORT"
  warn "port $UI_PORT free" 'port_free "$UI_PORT"' "set SKYRA_UI_PORT"
  [ "$ok" = 1 ] || die "fix the FAIL lines above"
  say "ready. Run 'skyra'."
}


case ${1:-} in
  "")            chat ;;
  chat)          chat "${2:-}" ;;
  tui)           tui_chat "${2:-}" ;;
  serve)         serve "${2:-}" ;;
  app)           app ;;
  replay)        [ $# -eq 2 ] || die "usage: skyra replay DIR"; controller_build; exec "$BUILD/controller/skyra" replay "$2" ;;
  ask)           shift; ask "$@" ;;
  stop)          stop_host ;;
  demo)          exec "$ROOT/controller/run.sh" ;;
  test)          exec "$ROOT/scripts/check.sh" ;;
  desktop)       shift; controller_build; exec python3 "$ROOT/controller/cua/session.py" "$@" ;;
  doctor)        doctor ;;
  build)         controller_build && say "built into $BUILD" ;;
  help|-h|--help) usage ;;
  *)             usage; exit 2 ;;
esac
