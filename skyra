#!/bin/bash
# skyra: one command for the whole project. Installed onto PATH by ./install.sh.
set -euo pipefail

# Resolve the repo root through the symlink install.sh puts on PATH.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
ROOT=$(cd "$(dirname "$self")" && pwd)
DNA=$ROOT/history/dna19
BUILD=$ROOT/build
WS_PORT=${SKYRA_WS_PORT:-8080}
UI_PORT=${SKYRA_UI_PORT:-3000}

say() { printf '\033[1mskyra:\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mskyra:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
usage: skyra [command]

  (none)        chat with Codex in the browser, through the stateless controller:
                every conversation is a lineage, saved and listed with its history
  chat --fake   the same, against a deterministic fake Codex (no model, no login)
  ask "TEXT"    one question to real Codex through the controller; prints the lineage,
                the replay check and the answer
  replay DIR    re-derive a finished conversation or run from its records
  stop          stop the Codex actor hosts that chat and ask leave running
  dna19         DNA-19, the predecessor: chat in the browser through its capability fence
                (dna19 --fake: a fake Codex; dna19 --echo: the echo agent)
  demo          the stateless controller: every scenario, each ending in a replay check
  test          every Go test (controller and DNA-19)
  live          DNA-19's live suite against your installed Codex (about a minute)
  doctor        check prerequisites
  build         build every binary into build/

Ports: SKYRA_WS_PORT (default 8080), SKYRA_UI_PORT (default 3000).
Setup and troubleshooting: $ROOT/startup-doc.md
EOF
}

build() {
  mkdir -p "$BUILD"
  cd "$ROOT"
  go build -o "$BUILD/root" ./history/dna19/root
  go build -o "$BUILD/user" ./history/dna19/user
  go build -o "$BUILD/codex" ./history/dna19/codex
  go build -o "$BUILD/echo" ./history/dna19/root/echo
  go build -o "$BUILD/fake-provider" ./history/dna19/codex/testdata/fake-provider
}

port_free() { ! lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

kill_tree() {
  local child
  for child in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$child"; done
  kill "$1" 2>/dev/null || true
}

dna19() {
  local mode=${1:-codex} provider=""
  case $mode in
    codex|--codex) mode=codex ;;
    --fake) mode=fake ;;
    --echo) mode=echo ;;
    *) die "unknown dna19 mode '$mode' (use --fake or --echo)" ;;
  esac
  if [ "$mode" = codex ]; then
    provider=$(command -v codex) || die "codex is not installed. Try 'skyra dna19 --fake', or see startup-doc.md"
    codex login status >/dev/null 2>&1 || die "codex is not logged in. Run 'codex login', or try 'skyra dna19 --fake'"
  fi
  [ -d "$ROOT/frontend/node_modules" ] || die "frontend dependencies missing. Run ./install.sh"
  port_free "$WS_PORT" || die "port $WS_PORT is in use (set SKYRA_WS_PORT, or stop the other process)"
  port_free "$UI_PORT" || die "port $UI_PORT is in use (set SKYRA_UI_PORT, or stop the other process)"

  say "building"
  build

  local addr=127.0.0.1:$WS_PORT runtime_pid ui_pid
  cleanup() {
    trap - INT TERM EXIT
    say "stopping"
    [ -n "${ui_pid:-}" ] && kill_tree "$ui_pid"
    [ -n "${runtime_pid:-}" ] && kill_tree "$runtime_pid"
    wait 2>/dev/null || true
  }
  trap cleanup INT TERM EXIT

  case $mode in
    codex) "$BUILD/root" user-codex-demo "$BUILD/user" "$BUILD/codex" "$DNA/codex/profiles.json" \
             "$provider" "$BUILD/echo" "$addr" app-server & ;;
    fake)  "$BUILD/root" user-codex-demo "$BUILD/user" "$BUILD/codex" "$DNA/codex/profiles.json" \
             "$BUILD/fake-provider" "$BUILD/echo" "$addr" & ;;
    echo)  "$BUILD/root" user-demo "$BUILD/user" "$BUILD/echo" "$addr" & ;;
  esac
  runtime_pid=$!

  (cd "$ROOT/frontend" && NEXT_PUBLIC_WS_URL="ws://$addr/ws" exec npm run dev -- -p "$UI_PORT") \
    >"$BUILD/ui.log" 2>&1 &
  ui_pid=$!

  local url=http://localhost:$UI_PORT i
  for i in $(seq 1 60); do
    kill -0 "$runtime_pid" 2>/dev/null || die "the runtime exited during startup (see the output above)"
    kill -0 "$ui_pid" 2>/dev/null || die "the UI exited during startup (see $BUILD/ui.log)"
    curl -s -o /dev/null "$url" && break
    sleep 1
  done
  say "agent: $mode   UI: $url   runtime trace below   Ctrl-C to stop"
  [ -n "${SKYRA_NO_OPEN:-}" ] || open "$url" 2>/dev/null || true

  # Stop everything when either side exits (closing the interaction ends the runtime).
  while kill -0 "$runtime_pid" 2>/dev/null && kill -0 "$ui_pid" 2>/dev/null; do sleep 1; done
}

# The stateless controller. Its actor hosts are long-lived by design
# (next/15): chat and ask start them once and leave them running; stop ends
# them. A real Codex and a fake one each get their own host.
STATE=$HOME/.skyra

controller_build() {
  mkdir -p "$BUILD/controller"
  cd "$ROOT"
  local t
  for t in skyra echo agent codex host user webhost; do go build -o "$BUILD/controller/$t" "./controller/$t"; done
  go build -o "$BUILD/controller/fake-codex" ./history/dna19/codex/testdata/fake-provider
}

# codex_host MODE: make sure the Codex actor host for MODE (real|fake) runs;
# prints its socket.
codex_host() {
  local mode=$1 sock=$STATE/codex-$1.sock pid=$STATE/codex-$1.pid actor
  mkdir -p "$STATE"
  if [ -S "$sock" ] && [ -f "$pid" ] && kill -0 "$(cat "$pid")" 2>/dev/null; then
    # The host outlives its actor: reuse it only if the actor still runs under it.
    if pgrep -P "$(cat "$pid")" >/dev/null; then
      echo "$sock"
      return
    fi
    say "the Codex actor under the $mode host exited; restarting the host" >&2
    kill "$(cat "$pid")" 2>/dev/null || true
  fi
  if [ "$mode" = real ]; then
    actor=$(command -v codex) || die "codex is not installed. Try '--fake', or see startup-doc.md"
    codex login status >/dev/null 2>&1 || die "codex is not logged in: run 'codex login', or try '--fake'"
    set -- "$actor" app-server
  else
    set -- "$BUILD/controller/fake-codex"
  fi
  rm -f "$sock"
  nohup "$BUILD/controller/host" -sock "$sock" -state "$STATE/codex-$mode-host" -- "$@" >>"$STATE/codex-$mode-host.log" 2>&1 &
  echo $! >"$pid"
  local i
  for i in $(seq 1 100); do [ -S "$sock" ] && break; sleep 0.1; done
  [ -S "$sock" ] || die "the Codex actor host did not start (see $STATE/codex-$mode-host.log)"
  echo "$sock"
}

# registry CODEX_SOCK PARK_SOCK: the operator's registry for the controller.
registry() {
  cat >"$BUILD/controller/registry.json" <<JSON
{
  "echo":    {"path": "echo",  "contract": "$ROOT/controller/echo/contract.json"},
  "codex":   {"path": "codex", "contract": "$ROOT/controller/codex/contract.json", "connect": ["$1"]},
  "user":    {"path": "user",  "contract": "$ROOT/controller/user/contract.json"},
  "browser": {"host": "$2",    "contract": "$ROOT/controller/browser/contract.json"}
}
JSON
  echo "$BUILD/controller/registry.json"
}

ask() {
  [ $# -gt 0 ] || die 'usage: skyra ask "TEXT"'
  say "building"
  controller_build
  local sock reg run
  sock=$(codex_host real)
  reg=$(registry "$sock" "$STATE/park.sock")
  mkdir -p "$STATE/runs"
  run=$STATE/runs/$(date +%Y%m%d-%H%M%S)-$$/.skyra
  mkdir -p "$run"
  "$BUILD/controller/skyra" boot -root "$run" -registry "$reg" -to codex -text "$*"
  say "state: $run"
}

# chat [--fake]: the browser UI on the stateless controller. The webhost holds
# every conversation waiting on you; each conversation is saved as its lineage
# under ~/.skyra/conversations (or conversations-fake).
chat() {
  local mode=real
  case ${1:-} in
    ""|--codex) ;;
    --fake) mode=fake ;;
    *) die "unknown chat mode '$1' (use --fake)" ;;
  esac
  [ -d "$ROOT/frontend/node_modules" ] || die "frontend dependencies missing. Run ./install.sh"
  port_free "$WS_PORT" || die "port $WS_PORT is in use (set SKYRA_WS_PORT, or stop the other process)"
  port_free "$UI_PORT" || die "port $UI_PORT is in use (set SKYRA_UI_PORT, or stop the other process)"
  say "building"
  controller_build

  local sock reg park=$STATE/park-$mode.sock convs=$STATE/conversations
  [ "$mode" = fake ] && convs=$STATE/conversations-fake
  sock=$(codex_host "$mode")
  reg=$(registry "$sock" "$park")

  local addr=127.0.0.1:$WS_PORT web_pid ui_pid
  cleanup() {
    trap - INT TERM EXIT
    say "stopping (the Codex actor host keeps running; 'skyra stop' ends it)"
    [ -n "${ui_pid:-}" ] && kill_tree "$ui_pid"
    [ -n "${web_pid:-}" ] && kill_tree "$web_pid"
    wait 2>/dev/null || true
  }
  trap cleanup INT TERM EXIT
  nohup "$BUILD/controller/webhost" -ws "$addr" -park "$park" -skyra "$BUILD/controller/skyra" \
    -registry "$reg" -conversations "$convs" &
  web_pid=$!
  (cd "$ROOT/frontend" && NEXT_PUBLIC_WS_URL="ws://$addr/ws" exec npm run dev -- -p "$UI_PORT") >"$BUILD/ui.log" 2>&1 &
  ui_pid=$!

  local url=http://localhost:$UI_PORT i
  for i in $(seq 1 60); do
    kill -0 "$web_pid" 2>/dev/null || die "the webhost exited during startup (see the output above)"
    kill -0 "$ui_pid" 2>/dev/null || die "the UI exited during startup (see $BUILD/ui.log)"
    curl -s -o /dev/null "$url" && break
    sleep 1
  done
  say "codex: $mode   UI: $url   conversations: $convs   runtime trace below   Ctrl-C to stop"
  [ -n "${SKYRA_NO_OPEN:-}" ] || open "$url" 2>/dev/null || true
  while kill -0 "$web_pid" 2>/dev/null && kill -0 "$ui_pid" 2>/dev/null; do sleep 1; done
}

stop_host() {
  local mode stopped=0
  for mode in real fake; do
    if [ -f "$STATE/codex-$mode.pid" ] && kill -0 "$(cat "$STATE/codex-$mode.pid")" 2>/dev/null; then
      kill_tree "$(cat "$STATE/codex-$mode.pid")"
      say "stopped the $mode Codex actor host"
      stopped=1
    fi
    rm -f "$STATE/codex-$mode.pid" "$STATE/codex-$mode.sock"
  done
  [ "$stopped" = 1 ] || say "no actor host running"
}

doctor() {
  local ok=1 v
  check() { if eval "$2" >/dev/null 2>&1; then printf '  ok    %s\n' "$1"; else printf '  FAIL  %s: %s\n' "$1" "$3"; ok=0; fi; }
  warn()  { if eval "$2" >/dev/null 2>&1; then printf '  ok    %s\n' "$1"; else printf '  warn  %s: %s\n' "$1" "$3"; fi; }
  echo "skyra doctor ($ROOT)"
  check "macOS" '[ "$(uname)" = Darwin ]' "the sandbox uses sandbox-exec, which is macOS only"
  check "sandbox-exec" 'command -v sandbox-exec' "missing from this macOS"
  v=$(go env GOVERSION 2>/dev/null || true)
  check "Go >= 1.25 (${v:-none})" '[ -n "$v" ] && [ "$(printf "%s\n" go1.25 "$v" | sort -V | head -1)" = go1.25 ]' "install Go 1.25+: brew install go"
  check "node and npm" 'command -v node && command -v npm' "install Node 20+: brew install node"
  check "frontend dependencies" '[ -d "$ROOT/frontend/node_modules" ]' "run ./install.sh"
  check "skyra on PATH" '[ "$(command -v skyra)" ]' "run ./install.sh, then open a new terminal"
  warn "codex installed ($(codex --version 2>/dev/null || echo none))" 'command -v codex' "only 'skyra chat' needs it; install: brew install codex"
  warn "codex logged in" 'codex login status' "run 'codex login' (a ChatGPT login works)"
  warn "port $WS_PORT free" 'port_free "$WS_PORT"' "set SKYRA_WS_PORT"
  warn "port $UI_PORT free" 'port_free "$UI_PORT"' "set SKYRA_UI_PORT"
  [ "$ok" = 1 ] || die "fix the FAIL lines above"
  say "ready. Run 'skyra'."
}

live() {
  local provider version
  provider=$(command -v codex) || die "codex is not installed"
  version=$(codex --version)
  cd "$ROOT"
  say "live suite against $version (writes fresh evidence to history/dna19/artifacts/)"
  DNA19_LIVE=1 DNA19_PROVIDER=$provider DNA19_PROVIDER_VERSION=$version DNA19_PROVIDER_ARGS='["app-server"]' \
    exec go test -v -count=1 ./history/dna19/root/boot -run '^TestLiveProvider$'
}

case ${1:-} in
  "")            chat ;;
  chat)          chat "${2:-}" ;;
  dna19)         dna19 "${2:-codex}" ;;
  replay)        [ $# -eq 2 ] || die "usage: skyra replay DIR"; controller_build; exec "$BUILD/controller/skyra" replay "$2" ;;
  ask)           shift; ask "$@" ;;
  stop)          stop_host ;;
  demo)          exec "$ROOT/controller/run.sh" ;;
  test)          cd "$ROOT" && exec go test -count=1 ./controller/... ./history/dna19/... ;;
  live)          live ;;
  doctor)        doctor ;;
  build)         build && say "built into $BUILD" ;;
  help|-h|--help) usage ;;
  *)             usage; exit 2 ;;
esac
